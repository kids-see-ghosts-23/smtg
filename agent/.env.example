# Stream credentials — use the SAME values as your Next.js app:
#   STREAM_API_KEY    = NEXT_PUBLIC_STREAM_VIDEO_API_KEY (from the app's .env)
#   STREAM_API_SECRET = STREAM_VIDEO_SECRET_KEY          (from the app's .env)
STREAM_API_KEY=
STREAM_API_SECRET=

# OpenAI key with Realtime GA access (same key the app uses is fine)
OPENAI_API_KEY=

# Optional overrides
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
